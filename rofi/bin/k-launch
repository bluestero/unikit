#!/usr/bin/env bash
# k-launch [apps|ssh|filebrowser|power|settings|speaker|mic|wifi|bluetooth]: the rofi launcher, as Alt+Space / Alt+Shift+Space run it.
#  - not open: opens it and gives it the keyboard (rofi is an X11 program, so GNOME
#    doesn't focus it on its own);
#  - open and you are in another window: brings it back to the front;
#  - open and focused: closes it (same key toggles);
#  - you switch to another window, minimize or click away: it closes by itself.
# Needs the Window Calls GNOME extension (./install.sh window-calls) for the focus
# part; without it rofi still opens, it just doesn't follow focus.
set -uo pipefail
mode=${1:-apps}
[[ "$mode" == drun ]] && mode=apps   # old name, same tab
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# settings = its own set of tabs (speaker, mic, wifi, bluetooth); Ctrl+Tab / Ctrl+Shift+Tab cycle them
modi="apps:$here/k-apps,ssh,filebrowser,power:$here/k-power"
extra=()
case "$mode" in
  settings|speaker|mic|wifi|bluetooth)
    modi="speaker:$here/k-speaker,mic:$here/k-mic,wifi:$here/k-wifi,bluetooth:$here/k-bluetooth"
    [[ "$mode" == settings ]] && mode=speaker
    # no icons here (their empty slot was a gap before each row); wider, for the long device names
    extra=(-no-show-icons -theme-str 'window { width: 660px; }') ;;
esac

# timings go to launch.log (apps, devices and this script all write there), to find the odd 1-2 s open
LOG=${XDG_CACHE_HOME:-$HOME/.cache}/work-toolkit/launch.log
mkdir -p "${LOG%/*}"
[[ $(stat -c %s "$LOG" 2>/dev/null || echo 0) -gt 200000 ]] && { tail -n 500 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; }
now() { local t=$EPOCHREALTIME; echo "${t/[.,]/}"; }            # microseconds
ms() { echo $(( ($(now) - $1) / 1000 )); }                       # ms since $1
log() { echo "$(date '+%F %T') launch[$mode]: $*" >> "$LOG"; }

WC=(gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell/Extensions/Windows)

# prints "<id> <true|false>" for rofi's window, nothing if there is none
rofi_win() {
  local o
  o=$("${WC[@]}" --method org.gnome.Shell.Extensions.Windows.List 2>/dev/null |
    grep -o '{[^{}]*"wm_class":"Rofi"[^{}]*}') || return 1
  [[ -n "$o" ]] || return 1
  echo "$(grep -o '"id":[0-9]*' <<<"$o" | head -1 | cut -d: -f2) $(grep -o '"focus":[a-z]*' <<<"$o" | head -1 | cut -d: -f2)"
}
activate() { "${WC[@]}" --method org.gnome.Shell.Extensions.Windows.Activate "$1" >/dev/null 2>&1; }

if read -r id focused < <(rofi_win); then
  if [[ "$focused" == true ]]; then pkill -x rofi; else activate "$id"; fi
  exit 0
fi

t0=$(now)

# The tabs of Super+S: rofi runs every tab one after the other before it shows anything, so
# one stuck tool (bluetoothctl, nmcli) held the window up for seconds. Start them all at once
# instead and give them 1.5 s; the tabs print what was fetched (k-devices --prefetch).
if [[ "$modi" == speaker:* ]]; then
  pre=$(mktemp -d)
  trap 'rm -rf "$pre"' EXIT
  pids=()
  for t in speaker mic wifi bluetooth; do "$here/k-$t" --prefetch "$pre" & pids+=($!); done
  for ((i = 0; i < 150; i++)); do
    [[ -e $pre/speaker && -e $pre/mic && -e $pre/wifi && -e $pre/bluetooth ]] && break
    sleep 0.01
  done
  kill "${pids[@]}" 2>/dev/null
  log "tabs ready in $(ms "$t0") ms ($(find "$pre" -type f ! -name '*.tmp' | wc -l)/4)"
  export K_PREFETCH=$pre
fi

t1=$(now)
rofi -normal-window -modi "$modi" "${extra[@]}" -show "$mode" &
pid=$!
seen=0 shown=0
for ((i = 0; i < 200; i++)); do   # up to 20 s; rofi ends first when you pick something
  kill -0 "$pid" 2>/dev/null || exit 0
  if read -r id focused < <(rofi_win); then
    ((shown)) || { shown=1; log "window visible after $(ms "$t1") ms"; }
    if [[ "$focused" == true ]]; then
      ((seen)) || log "focused after $(ms "$t1") ms (total $(ms "$t0") ms)"
      seen=1
    elif ((seen)); then pkill -x rofi; exit 0      # lost focus: close
    else activate "$id"; fi                         # not focused yet: ask for it
  fi
  # each window-list call runs inside GNOME Shell, on the thread that draws the open/close
  # animation: asking often made it stutter, so ask quickly only until rofi has focus
  if ((seen)); then sleep 0.25; else sleep 0.1; fi
  ((i > 190)) && ((seen)) && i=100                  # keep watching while it stays open
done
