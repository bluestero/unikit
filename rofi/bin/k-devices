#!/usr/bin/env -S python3 -I
"""k-devices: rofi's speaker / mic / wifi / bluetooth tabs (script mode, started by k-launch).
One script, four names: it works out which tab it is from the name it was started as
(k-speaker, k-mic, k-wifi, k-bluetooth are symlinks to it). Pick a row to switch to it;
the result comes as a desktop notification. A wifi network with a password asks for it
in the same list (type it, Enter)."""
import contextlib, html, io, json, os, re, subprocess, sys, time

KIND = os.path.basename(sys.argv[0]).removeprefix("k-")
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "k-devices-wifi")
LOG = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "work-toolkit", "launch.log")
TIMEOUT = 8   # seconds a tool may take; a prefetch (below) gives it 2


def log(msg):
    """one line in launch.log (k-launch rotates it): what was slow, to find the odd 1-2 s open"""
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(time.strftime("%F %T ") + msg + "\n")
    except OSError:
        pass


def out(*cmd):
    t = time.monotonic()
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=TIMEOUT).stdout
    except Exception as e:
        log(f"{KIND}: {cmd[0]} failed after {time.monotonic() - t:.2f}s ({type(e).__name__})")
        return ""
    finally:
        if time.monotonic() - t > 0.3:
            log(f"{KIND}: {cmd[0]} took {time.monotonic() - t:.2f}s")


def bg(script, *args, stdin=""):
    """run a shell snippet detached (so rofi can close right away); args arrive as $1, $2 ..."""
    p = subprocess.Popen(["setsid", "-f", "sh", "-c", script, "k-devices", *args], stdin=subprocess.PIPE,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    p.communicate(stdin.encode())


def notify(msg):   # shell snippet; msg may use "$1"
    return f'notify-send -a k-devices -i audio-card Devices "{msg}"'


def head(prompt_msg=None, custom=False):
    print("\0markup-rows\x1ftrue")
    if prompt_msg:
        print(f"\0message\x1f{prompt_msg}")
    if not custom:
        print("\0no-custom\x1ftrue")


def row(label, info, active=False):
    label = html.escape(label.replace("\n", " "), quote=False)
    print(("● " if active else "  ") + label + "\0info\x1f" + info)


# ------------------------------------------------------------- speaker / mic ---
def audio():
    want = "Sinks" if KIND == "speaker" else "Sources"
    sec, rows = "", []
    for line in out("wpctl", "status").splitlines():
        s = re.sub(r"^[\s│├└─]+", "", line)
        if re.match(r"^[A-Za-z ]+:$", s):
            sec = s[:-1]
            continue
        m = re.match(r"^(\*)?\s*(\d+)\.\s+(.*?)\s+\[vol: ([\d.]+)( MUTED)?\]", s)
        if sec == want and m:
            rows.append((m[3], m[2], bool(m[1]), round(float(m[4]) * 100), bool(m[5])))
    return rows


# Bluetooth earbuds have two modes (card profiles); wpctl only lists the one in use, so
# like GNOME's menu each mode gets its own row. Speaker: both; mic: only Handsfree has one.
# A mode the device isn't offering right now still gets its row; picking it asks the device
# for that link (its Bluetooth profile UUID) and then switches.
BT_MODES = [("Headset", "a2dp-sink", "music", "0000110b-0000-1000-8000-00805f9b34fb"),
            ("Handsfree", "headset-head-unit", "calls, with mic", "0000111e-0000-1000-8000-00805f9b34fb")]


def bt_cards():
    """({device id: (name, active profile, {profile: index}, bluez path)} for bluetooth audio,
    {sink or source node id: its device id})"""
    try:
        # only the first array: other pw-dumps running at once (the mic tab) add removal notices after it
        objs = json.JSONDecoder().raw_decode(out("pw-dump"))[0]
    except ValueError:
        return {}, {}
    cls = "Audio/Sink" if KIND == "speaker" else "Audio/Source"
    cards, node_dev = {}, {}
    for o in objs:
        info = o.get("info") or {}
        p = info.get("props") or {}
        if p.get("media.class") == "Audio/Device" and p.get("device.api") == "bluez5":
            par = info.get("params") or {}
            profs = {x["name"]: x["index"] for x in par.get("EnumProfile", []) if x.get("available") != "no"}
            cards[o["id"]] = (p.get("device.description", "?"), (par.get("Profile") or [{}])[0].get("name", ""), profs,
                              p.get("api.bluez5.path", ""))
        elif p.get("media.class") == cls and "device.id" in p:
            node_dev[o["id"]] = int(p["device.id"])
    return cards, node_dev


def profile_index(profs, prefix):
    return profs.get(prefix, next((i for n, i in profs.items() if n.startswith(prefix)), None))


def bt_rows(dev, card, node=None):
    name, active, profs, _ = card
    for mode, prefix, hint, _ in BT_MODES[0 if KIND == "speaker" else 1:]:
        if node and active.startswith(prefix):
            _, wid, cur, vol, muted = node
            row(f"{name}  ·  {mode} ({hint})  ·  {'muted' if muted else str(vol) + '%'}", "a:" + wid, cur)
        else:
            idx = profile_index(profs, prefix)
            if idx is not None:
                row(f"{name}  ·  {mode} ({hint})", f"p:{dev}:{idx}")
            else:
                row(f"{name}  ·  {mode} ({hint})  ·  not available", f"c:{dev}:{prefix}")


def list_audio():
    head("Pick one to make it the default")
    cards, node_dev = bt_cards()
    nodes = {}   # Bluetooth device: its sink/source; listed last, Headset then Handsfree
    for r in audio():
        dev = node_dev.get(int(r[1]))
        if dev in cards:
            nodes[dev] = r
        else:
            name, wid, cur, vol, muted = r
            row(f"{name}  ·  {'muted' if muted else str(vol) + '%'}", "a:" + wid, cur)
    for dev, card in cards.items():   # no node: e.g. the mic tab while the buds play music
        bt_rows(dev, card, nodes.get(dev))


def default_for(dev):
    """after a mode switch: wait for the device's new sink/source, make it the default"""
    for _ in range(25):
        ids = [n for n, d in bt_cards()[1].items() if d == dev]
        if ids:
            subprocess.run(["wpctl", "set-default", str(ids[0])])
            subprocess.run(["notify-send", "-a", "k-devices", "-i", "audio-card", "Devices", "Default " + KIND + " changed"])
            return
        time.sleep(0.2)


def bring_up(dev, prefix):
    """a mode the device isn't offering: ask it for that link, wait for the mode, switch to it"""
    mode, _, _, uuid = next(m for m in BT_MODES if m[1] == prefix)
    card = bt_cards()[0].get(dev)
    if card and card[3]:   # "busy" when the link is already there: the wait below still decides
        subprocess.run(["busctl", "call", "org.bluez", card[3], "org.bluez.Device1", "ConnectProfile", "s", uuid],
                       capture_output=True, timeout=TIMEOUT)
    for _ in range(25):
        card = bt_cards()[0].get(dev)
        idx = card and profile_index(card[2], prefix)
        if idx is not None:
            subprocess.run(["wpctl", "set-profile", str(dev), str(idx)])
            default_for(dev)
            return
        time.sleep(0.2)
    subprocess.run(["notify-send", "-a", "k-devices", "-i", "audio-card", "Devices",
                    f"{mode} isn't available: put the earbuds in their case, then take them out"])


# ------------------------------------------------------------------ bluetooth ---
def bt_devices():
    res = []
    for line in out("bluetoothctl", "devices", "Paired").splitlines():
        m = re.match(r"Device (\S+) (.*)", line)
        if m:
            on = "Connected: yes" in out("bluetoothctl", "info", m[1])
            res.append((m[2], m[1], on))
    return res


def list_bt():
    powered = "Powered: yes" in out("bluetoothctl", "show")
    head("Pick a device to connect or disconnect" if powered else "Bluetooth is off")
    row("Turn Bluetooth " + ("off" if powered else "on"), "bt-power:" + ("off" if powered else "on"))
    if powered:
        for name, mac, on in bt_devices():
            row(f"{name}  ·  {'connected' if on else 'not connected'}", "bt:" + mac, on)


# ----------------------------------------------------------------------- wifi ---
def split_terse(line):
    return [c.replace("\\:", ":") for c in re.split(r"(?<!\\):", line)]


def list_wifi():
    if out("nmcli", "radio", "wifi").strip() != "enabled":
        head("Wi-Fi is off")
        row("Turn Wi-Fi on", "wifi-power:on")
        return
    saved = {split_terse(l)[0] for l in out("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show").splitlines()
             if split_terse(l)[1:2] == ["802-11-wireless"]}
    best = {}
    # the last scan's results: a fresh scan takes seconds, and rofi runs every tab before it opens;
    # rescan in the background so the next open is up to date
    bg("nmcli device wifi rescan")
    for line in out("nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "no").splitlines():
        use, ssid, sig, sec = (split_terse(line) + ["", "", "", ""])[:4]
        if not ssid:
            continue
        cur = best.get(ssid)
        if cur is None or use == "*" or (cur[0] != "*" and int(sig or 0) > cur[1]):
            best[ssid] = (use, int(sig or 0), sec)
    head("Pick a network to connect to")
    row("Turn Wi-Fi off", "wifi-power:off")
    for ssid, (use, sig, sec) in sorted(best.items(), key=lambda kv: (kv[1][0] != "*", -kv[1][1])):
        kind = "saved" if ssid in saved else ("password needed" if sec else "open")
        row(f"{ssid}  ·  {sig}%  ·  {kind}", "w:" + ssid, use == "*")


def wifi_connect(ssid, known, password=None):
    done = f"{notify('Connected to $1')} || {notify('Could not connect to $1')}"
    if password is not None:
        bg(f'nmcli --ask device wifi connect "$1" && {done}', ssid, stdin=password + "\n")
    elif known:
        bg(f'nmcli connection up id "$1" && {done}', ssid)
    else:
        bg(f'nmcli device wifi connect "$1" && {done}', ssid)


# ----------------------------------------------------------------------- main ---
LISTERS = {"speaker": list_audio, "mic": list_audio, "wifi": list_wifi, "bluetooth": list_bt}


def prefetch(directory):
    """k-launch starts the four tabs at once, because rofi runs them one after the other
    (and one stuck tool would hold the window up); each writes its list to a file here
    and the listing below prints it."""
    global TIMEOUT
    TIMEOUT = 2
    t = time.monotonic()
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        LISTERS.get(KIND, list_audio)()
    with open(os.path.join(directory, KIND + ".tmp"), "w") as f:
        f.write(buf.getvalue())
    os.rename(os.path.join(directory, KIND + ".tmp"), os.path.join(directory, KIND))
    log(f"{KIND}: listed in {time.monotonic() - t:.2f}s")


def listing():
    pre = os.environ.get("K_PREFETCH", "")
    ready = os.path.join(pre, KIND)
    if os.path.exists(ready):
        sys.stdout.write(open(ready).read())
    elif os.path.isdir(pre):   # k-launch gave up waiting for this tab
        head("Took too long to load: close and open again")
        log(f"{KIND}: not ready in time")
    else:
        LISTERS.get(KIND, list_audio)()


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    info = os.environ.get("ROFI_INFO", "")
    retv = os.environ.get("ROFI_RETV", "0")

    if arg == "--prefetch":      # started by k-launch, one per tab
        prefetch(sys.argv[2])
        return
    if arg == "--default-for":   # started by the "p:" pick below, detached
        default_for(int(sys.argv[2]))
        return
    if arg == "--bring-up":      # started by the "c:" pick below, detached
        bring_up(int(sys.argv[2]), sys.argv[3])
        return
    if KIND == "wifi" and retv == "2" and os.path.exists(STATE):   # typed text = the password
        ssid = open(STATE).read()
        os.remove(STATE)
        wifi_connect(ssid, False, arg)
        return
    if arg and os.path.exists(STATE):
        os.remove(STATE)

    if info.startswith("a:"):
        bg(f"wpctl set-default {info[2:]} && {notify('Default ' + KIND + ' changed')}")
    elif info.startswith("p:"):
        dev, idx = info[2:].split(":")
        bg(f'wpctl set-profile {dev} {idx} && "$1" --default-for {dev}', os.path.abspath(sys.argv[0]))
    elif info.startswith("c:"):
        dev, prefix = info[2:].split(":")
        bg('"$1" --bring-up "$2" "$3"', os.path.abspath(sys.argv[0]), dev, prefix)
    elif info.startswith("bt-power:"):
        bg(f"bluetoothctl power {info[9:]}")
    elif info.startswith("bt:"):
        mac = info[3:]
        on = any(m == mac and c for _, m, c in bt_devices())
        verb, done = ("disconnect", "Disconnected") if on else ("connect", "Connected")
        bg(f"bluetoothctl {verb} {mac} && {notify(done)} || {notify('Bluetooth ' + verb + ' failed')}")
    elif info.startswith("wifi-power:"):
        bg(f"nmcli radio wifi {info[11:]}")
    elif info.startswith("w:"):
        ssid = info[2:]
        net = [split_terse(l) for l in out("nmcli", "-t", "-f", "SSID,SECURITY", "device", "wifi", "list").splitlines()]
        secured = any(n[0] == ssid and n[1:2] and n[1] for n in net)
        known = ssid in {split_terse(l)[0] for l in out("nmcli", "-t", "-f", "NAME", "connection", "show").splitlines()}
        if secured and not known:
            open(STATE, "w").write(ssid)
            head(f"Password for {ssid}: type it and press Enter (Esc cancels)", custom=True)
            print("Cancel\0info\x1fcancel")
        else:
            wifi_connect(ssid, known)
    elif info == "cancel":
        pass
    else:
        listing()


main()
