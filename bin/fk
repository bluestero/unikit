#!/usr/bin/env bash
# fk - the feelkit: how things look. Empty until layers fill it: their fk parts (fk install),
# their commands (tools lines for fk) and subcommands (a layer's fk/<name> is fk <name>).
# The same words as tk (lib/kit.sh). `fk help` lists them.
set -uo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "${SELF%/*}/.." && pwd)"
KIT=fk
KIT_WHAT="how things look"
# shellcheck source=../lib/kit.sh
. "$ROOT/lib/kit.sh"
kit_main "$@"
