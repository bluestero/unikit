#!/usr/bin/env bash
# uk (unikit) - the base: its layers (extra parts from other repos, in layers/<name>),
# whether they are well formed, the version. The kits are tk (toolkit: what you work
# with) and fk (feelkit: how it looks); each sets up its own parts. `uk help` lists it all.
set -uo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/ui.sh
. "$ROOT/lib/ui.sh"
# shellcheck source=../lib/layers.sh
. "$ROOT/lib/layers.sh"
# shellcheck source=../lib/inplace.sh
. "$ROOT/lib/inplace.sh"
S=$'\x1f'

version() { tr -d '[:space:]' <"$ROOT/VERSION" 2>/dev/null || printf 'unknown'; }
rev_of() { git -C "$1" log -1 --format='%h, %cs' 2>/dev/null; }
# a layer's version: its VERSION file (if it has one) and its commit
layer_ver() {
  local v r; own_repo "$1" && r=$(rev_of "$1")
  [[ -r $1/VERSION ]] && v=$(tr -d '[:space:]' <"$1/VERSION")
  if [[ -n ${v:-} ]]; then printf '%s%s' "$v" "${r:+ ($r)}"; else printf '%s' "${r:-–}"; fi
}
layer_from() {
  if own_repo "$1"; then git -C "$1" remote get-url origin 2>/dev/null || echo "a git repo with no remote"
  else echo "a copied folder (no updates)"; fi
}

# Every installer part the layers bring: "layer TAB kit TAB id" (2>: the loader's warnings)
layer_parts() {
  ( repo=$ROOT mode=dry details=0
    # shellcheck source=../lib/setup.sh
    . "$ROOT/lib/setup.sh" >/dev/null 2>&1
    # shellcheck source=../lib/components.sh
    . "$ROOT/lib/components.sh" >/dev/null
    for id in "${COMPONENTS[@]}"; do
      [[ -v LAYER_OF[$id] ]] && printf '%s\t%s\t%s\n' "${LAYER_OF[$id]}" "$(kit_of "$id")" "$id"
    done )
}
# the kits a layer feeds: its parts' and its commands'
layer_feeds() {   # dir parts-file
  local l=${1##*/} k lk t
  lk=$(layer_kit "$1")
  { awk -F'\t' -v l="$l" '$1 == l { print $2 }' "$2"
    [[ -r $1/tools ]] && while IFS= read -r t; do
      [[ -z $t || $t == \#* ]] && continue
      IFS='|' read -r _ _ _ _ k <<<"$t"; echo "${k:-$lk}"
    done <"$1/tools"
  } | sort -u | paste -sd' '
}

# ------------------------------------------------------------- the list ---
# A layer per row: name · the kits it feeds · where from · version, its name after a TAB
lay_rows() {
  local d parts f
  parts=$(mktemp); layer_parts >"$parts" 2>/dev/null
  printf 'LAYER%sFEEDS%sFROM%sVERSION\t\n' "$S" "$S" "$S"
  while IFS= read -r d; do
    f=$(layer_feeds "$d" "$parts")
    printf '%s\t%s\n' "${C_CYAN}${d##*/}${C_RESET}$S${f:-–}$S$C_DIM$(layer_from "$d")$C_RESET$S$(layer_ver "$d")" "${d##*/}"
  done < <(layer_dirs "$ROOT")
  rm -f "$parts"
}
LAY_KEYS="# The layers: extra parts from other repos, in layers/<name>
enter: what to do with it · alt-a: add a layer · alt-i: about it (on/off) · esc: close"
lay_lay() { print_table 3 "$(ui_pick_width)" <"$IP/cells.$1" >"$IP/rows.$1"; }
lay_relist() { lay_rows >"$IP/cells.list"; lay_lay list; cat "$IP/rows.list"; }
lay_menu_rows() {
  printf 'CHOICE%sWHAT IT DOES\t\n' "$S"
  printf '%s\t%s\n' "Set up its parts${S}its parts' tabs in the installer, nothing ticked" setup \
    "Remove its parts${S}the uninstaller for its parts, putting your own settings back" undo \
    "Remove this layer${S}delete its folder (its parts stay set up)" rm
}

cmd_layers() {
  if [[ ! -t 0 || ! -t 1 ]] || ! type -P fzf >/dev/null || ! ui_fzf_at_least 0.63; then layer_ls; return; fi
  IP=$(mktemp -d) || return 1; export IP
  trap 'rm -rf "$IP" "$ROOT"/layers/.new-*' EXIT
  ip_set mode list
  lay_rows >"$IP/cells.list"; lay_lay list
  local cb k then cur
  cb="bash $(printf %q "$SELF") __key"
  local -a binds=(--bind "start:unbind(y,n)" --bind "alt-i:toggle-preview")
  for k in enter esc y n alt-a resize; do binds+=(--bind "$k:transform:$cb $k {2} {q}"); done
  ui_fzf 'uk · layers' --toast --with-shell='bash -c' --delimiter='\t' --with-nth=1 --header-lines=1 \
    --prompt='layer> ' --footer=' ' --header="$LAY_KEYS" "${binds[@]}" \
    --preview="bash $(printf %q "$SELF") __about {2}" --preview-window='right,55%,wrap,hidden' \
    <"$IP/rows.list" >/dev/null
  then=$(ip_get then) cur=$(ip_get cur)
  rm -rf "$IP" "$ROOT"/layers/.new-*; trap - EXIT
  case $then in   # what the list was left for: the installer, in this terminal
    setup) exec "$ROOT/install.sh" --layer="$cur" ;;
    undo)  exec "$ROOT/uninstall.sh" --layer="$cur" ;;
  esac
  return 0
}

lay_to_list() {   # [toast]: back to the layers, the cursor on the current one
  local n; n=$(awk -F'\t' -v id="$(ip_get cur)" '$2 == id { print NR - 1; exit }' "$IP/rows.list")
  local -a a=("$(ip_back)" "$(ip_fz reload-sync "bash $(printf %q "$SELF") __relist")" "pos(${n:-1})"
    "$(ip_fz change-header "$(ui_keys "$LAY_KEYS")")" "$(ip_fz change-prompt 'layer> ')")
  if [[ -n ${1:-} ]]; then a+=("$(ui_toast "$1")"); else a+=("$(ip_fz change-footer " ")"); fi
  ip_join "${a[@]}"
}

# why a layer can't be removed now (work that would be lost), or nothing
rm_blocked() {
  local dir=$ROOT/layers/$1
  own_repo "$dir" || return 1
  if [[ -n $(git -C "$dir" status --porcelain) ]] || ! git -C "$dir" rev-parse '@{u}' >/dev/null 2>&1 ||
     [[ -n $(git -C "$dir" log --oneline '@{u}..') ]]; then
    echo "layers/$1 has work that isn't pushed (uncommitted, or commits not on its remote). Push it first, or delete the folder yourself."
  fi
}
# the name a layer gets from its URL: unix-feelkit -> feelkit, acme-toolkit -> acme
url_name() { local n; n=$(basename "${1%.git}"); n=${n#unix-}; printf '%s' "${n%-toolkit}"; }

# What runs if you trust a layer, one line each: where from at which commit, then its code
trust_card() {   # dir
  local d=$1 f c="" n
  printf 'from %s at %s\n' "$(git -C "$d" remote get-url origin 2>/dev/null)" \
    "$(git -C "$d" log -1 --format='%h (%cs, %an: %s)' 2>/dev/null)"
  [[ -r $d/shell/init.sh ]] && printf '• every new shell runs its shell/init.sh (%s lines)\n' "$(wc -l <"$d/shell/init.sh")"
  for f in "$d"/bin/*; do [[ -f $f ]] && c+="${f##*/}, "; done
  [[ -n $c ]] && printf '• commands: %s\n' "${c%, }"
  c=""; for f in "$d"/tk/* "$d"/fk/*; do [[ -f $f ]] && c+="$(basename "$(dirname "$f")") ${f##*/}, "; done
  [[ -n $c ]] && printf '• kit subcommands: %s\n' "${c%, }"
  if [[ -r $d/components.sh ]]; then
    n=$( (COMPONENTS=(); . "$d/components.sh" >/dev/null 2>&1; printf '%s' "${#COMPONENTS[@]}") )
    printf '• setting up its %s part(s) runs its components.sh\n' "$n"
  fi
  if compgen -G "$d/claude/skills/*/" >/dev/null; then
    c=""; for f in "$d"/claude/skills/*/; do f=${f%/}; c+="${f##*/}, "; done
    printf '• Claude skills (what Claude is told to do): %s\n' "${c%, }"
  fi
  [[ -n $(layer_missing "$d") ]] && printf '• it needs layers that aren'"'"'t here: %s\n' "$(layer_missing "$d" | paste -sd' ')"
  return 0
}
# keep a cloned layer: from layers/.new-<name> to layers/<name>, its commit pinned
trust_keep() {   # name
  mv "$ROOT/layers/.new-$1" "$ROOT/layers/$1" && pin_set "$ROOT" "$1" "$(git -C "$ROOT/layers/$1" rev-parse HEAD)"
}

lay_key() {   # key value query
  local k=$1 v=$2 q=$3 m url name dir err
  m=$(ip_get mode)
  if [[ $k == resize ]]; then
    local w=list; [[ $m == menu ]] && w=menu
    lay_lay "$w"; ip_join "$(ip_fz reload-sync "cat $(printf %q "$IP/rows.$w")")" "pos(${FZF_POS:-1})"; return
  fi
  case $m in
    list)
      case $k in
        esc) echo abort ;;
        alt-a) ip_set saved_q "$q"; ip_ask "The layer's git URL? (a name for it after a space, if you want another)" add "" "url> " ;;
        enter)
          [[ -n $v ]] || return 0
          ip_set saved_q "$q"; ip_set mode menu; ip_set cur "$v"
          lay_menu_rows >"$IP/cells.menu"; lay_lay menu
          ip_join "$(ip_fz reload-sync "cat $(printf %q "$IP/rows.menu")")" first "$(ip_fz change-query "")" disable-search \
            "$(ip_fz change-header "$(ui_keys "# The $v layer ($(layer_from "$ROOT/layers/$v"))"$'\n'"enter: do it · esc: back")")" \
            "$(ip_fz change-prompt "$v> ")" "$(ip_fz change-footer " ")" ;;
      esac ;;
    menu)
      name=$(ip_get cur)
      case $k in
        esc) lay_to_list ;;
        enter)
          case $v in
            setup|undo) ip_set then "$v"; echo accept ;;
            rm)
              err=$(rm_blocked "$name"); [[ -n $err ]] && { lay_to_list "✗ $err"; return; }
              local undo="tk uninstall --layer=$name" lk; lk=$(layer_kit "$ROOT/layers/$name")
              [[ $lk != tk ]] && undo="$lk uninstall"
              ip_confirm "Remove the $name layer? This deletes ${ROOT/#$HOME/\~}/layers/$name. Parts it set up stay set up (Remove its parts first takes them out: $undo)." rm n ;;
          esac ;;
      esac ;;
    ask)
      case $k in
        esc) lay_to_list ;;
        enter)
          read -r url name <<<"$q"
          [[ -n $url ]] || { ip_reask "Type the git URL, e.g. git@github.com:me/acme-toolkit.git"; return; }
          name=${name:-$(url_name "$url")}
          [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || { ip_reask "'$name' can't be a folder name: give one after the URL"; return; }
          dir=$ROOT/layers/$name
          [[ -e $dir ]] && { ip_reask "layers/$name is already there: give it another name after the URL"; return; }
          mkdir -p "$ROOT/layers"; rm -rf "$ROOT/layers/.new-$name"
          # cloned aside (nothing loads it yet); no terminal to type a password in: git fails instead of waiting
          err=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes" git clone -q "$url" "$ROOT/layers/.new-$name" 2>&1) ||
            { rm -rf "$ROOT/layers/.new-$name"; ip_reask "couldn't clone it: $(grep -v '^$' <<<"$err" | tail -1)"; return; }
          ip_set cur "$name"; ip_set saved_q ""
          ip_confirm "Trust $name? What's above runs on this machine." trust n "$(trust_card "$ROOT/layers/.new-$name")" ;;
      esac ;;
    confirm)
      local a; a=$(ip_answer "$k"); [[ -n $a ]] || return 0
      name=$(ip_get cur)
      case $(ip_get pending) in
        trust)
          if [[ $a != yes ]]; then rm -rf "${ROOT:?}/layers/.new-$name"; lay_to_list "Not added: nothing of $name is left"; return; fi
          trust_keep "$name" || { lay_to_list "✗ couldn't move layers/.new-$name to layers/$name"; return; }
          local miss note=""; miss=$(layer_missing "$ROOT/layers/$name" | paste -sd' ')
          [[ -n $miss ]] && note="${C_YELLOW}! it needs layers that aren't here: $miss; alt-a adds them${C_RESET}"
          ip_join "$(ip_fz reload-sync "bash $(printf %q "$SELF") __relist")" \
            "$(ip_confirm "Added $name (its commands load in new terminals). Set up its parts now?" setup y "$note")" ;;
        setup) if [[ $a == yes ]]; then ip_set then setup; echo accept
               else lay_to_list "✓ layer $name added · later: uk layers, or $(layer_kit "$ROOT/layers/$name") install"; fi ;;
        rm) if [[ $a == yes ]]; then
              rm -rf "${ROOT:?}/layers/$name" && pin_set "$ROOT" "$name" && lay_to_list "✓ layer $name removed · open a new terminal"
            else lay_to_list "Kept."; fi ;;
      esac ;;
  esac
}

# The about card: what a layer is, where from, which version, what it brings
lay_about() {
  local name=$1 d=$ROOT/layers/$1 what="" lk t c cmds="" f parts kits k ids n set
  [[ -d $d ]] || return 0
  # what it is: its README's first paragraph, links as their words
  [[ -r $d/README.md ]] && what=$(awk '/^#/ { next } NF { p = p (p ? " " : "") $0; next } p { exit } END { print p }' "$d/README.md" |
    sed 's/\[\([^]]*\)\]([^)]*)/\1/g')
  lk=$(layer_kit "$d")
  {
    printf '%s\n' "$C_BOLD$name$C_RESET"
    [[ -n $what ]] && printf '%s\n' "$what"
    printf '\n'
    printf 'from\t%s\n' "$(layer_from "$d")"
    printf 'version\t%s\n' "$(layer_ver "$d")"
    own_repo "$d" && printf 'updated\t%s\n' "$(git -C "$d" log -1 --format='%cr' 2>/dev/null)"
    printf 'kit\t%s\n' "$lk (${KIT_LABEL[$lk]:-?}): its parts go there unless one names another"
    # its parts per kit, and how many are set up
    parts=$( ( repo=$ROOT mode=dry details=0
      . "$ROOT/lib/setup.sh" >/dev/null 2>&1; . "$ROOT/lib/components.sh" >/dev/null 2>&1
      for id in "${COMPONENTS[@]}"; do
        [[ ${LAYER_OF[$id]:-} == "$name" ]] || continue
        component_state "$id" >/dev/null 2>&1
        printf '%s %s %s\n' "$(kit_of "$id")" "$id" "$STATE"
      done ) )
    kits=$(cut -d' ' -f1 <<<"$parts" | sort -u)
    for k in $kits; do
      ids=$(awk -v k="$k" '$1 == k { print $2 }' <<<"$parts" | paste -sd' ')
      n=$(awk -v k="$k" '$1 == k && $3 != "n/a" && $3 != "unsupported"' <<<"$parts" | wc -l)
      set=$(awk -v k="$k" '$1 == k && $3 == "installed"' <<<"$parts" | wc -l)
      printf '%s parts\t%s\n' "$k" "$set of $n set up ($k install): $ids"
    done
    [[ -z $kits ]] && printf 'parts\t%s\n' "none"
    if [[ -r $d/tools ]]; then
      while IFS= read -r t; do [[ -z $t || $t == \#* ]] || cmds+="${t%%|*}, "; done <"$d/tools"
    fi
    for f in "$d"/bin/*; do
      [[ -x $f ]] || continue; c=${f##*/}; [[ $c == fk-* ]] && c="fk ${c#fk-}"
      [[ ", $cmds" == *", $c, "* ]] || cmds+="$c, "
    done
    [[ -n $cmds ]] && printf 'commands\t%s\n' "${cmds%, }"
    [[ -r $d/shell/init.sh ]] && printf 'shell\t%s\n' "adds settings to every new shell (shell/init.sh)"
    if compgen -G "$d/claude/skills/*/" >/dev/null; then
      printf 'skills\t%s\n' "$(for f in "$d"/claude/skills/*/; do f=${f%/}; printf '%s, ' "${f##*/}"; done | sed 's/, $//')"
    fi
    [[ -r $d/workspaces ]] && printf 'workspaces\t%s\n' "a shared ws list (@$name in yours brings it in)"
  } | while IFS=$'\t' read -r k t; do
    if [[ -z $t ]]; then printf '%s\n' "$k"; else printf '%s%-11s%s%s\n' "$C_DIM" "$k" "$C_RESET" "$t"; fi
  done
}

# Without a terminal: the layers as a table
layer_ls() {
  [[ -t 1 ]] || ui_no_color
  local d n=0 rows="${C_BOLD}LAYER${C_RESET}$S${C_BOLD}FROM${C_RESET}$S${C_BOLD}VERSION${C_RESET}"$'\n'
  while IFS= read -r d; do
    n=$((n + 1))
    rows+="  $C_CYAN${d##*/}$C_RESET$S$(layer_from "$d")$S$(layer_ver "$d")"$'\n'
  done < <(layer_dirs "$ROOT")
  (( n )) || { info "No layers yet. Add one: uk layer add <git-url>"; return 0; }
  printf '%s' "$rows" | ui_table "uk · layers" "$n layer$( (( n > 1 )) && echo s)" "$(ui_hint 'uk layer add <git-url> · uk layer rm <name>')"
}

layer_add() {
  local url name dir later yes=0 a new; local -a args=()
  for a; do case $a in -y|--yes) yes=1 ;; *) args+=("$a") ;; esac; done
  url=${args[0]:-}
  [[ -n $url ]] || die "which repo? uk layer add <git-url> [name]   e.g. git@github.com:me/acme-toolkit.git"
  name=${args[1]:-$(url_name "$url")}
  dir="$ROOT/layers/$name" new="$ROOT/layers/.new-$name"
  [[ -e $dir ]] && die "layers/$name is already there (uk layers)"
  mkdir -p "$ROOT/layers"; rm -rf "$new"
  git clone -q "$url" "$new" || { rm -rf "$new"; die "couldn't clone $url (no access? check: ssh -T git@github.com)"; }
  info "${C_BOLD}$name${C_RESET}: its code runs on this machine:"
  trust_card "$new" | sed 's/^/  /' >&2
  if (( ! yes )); then
    [[ -t 0 ]] || { rm -rf "$new"; die "not added: no terminal to ask in (uk layer add --yes <git-url> trusts it without asking)"; }
    confirm "Trust $name and add it?" n || { rm -rf "$new"; info "Not added."; return 0; }
  fi
  trust_keep "$name" || die "couldn't move layers/.new-$name to layers/$name"
  ok "layer $name added: ${dir/#$HOME/\~} (pinned at $(git -C "$dir" rev-parse --short HEAD))"
  local t; for t in $(layer_missing "$dir"); do warn "it needs the $t layer, which isn't here: uk layer add <its git URL>"; done
  info "${C_DIM}Its commands and settings load in new terminals.${C_RESET}"
  later="tk install --layer=$name"
  [[ $(layer_kit "$dir") != tk ]] && later="$(layer_kit "$dir") install"   # its parts are fk's (fk install)
  confirm "Set up its parts now?" y && exec "$ROOT/install.sh" --layer="$name"
  info "Later: $later"
}

layer_rm() {
  local name=${1:-} dir err undo
  [[ -n $name ]] || die "which layer? uk layer rm <name>   (uk layers)"
  dir="$ROOT/layers/$name"
  [[ -d $dir ]] || die "there's no layer $name (uk layers)"
  err=$(rm_blocked "$name"); [[ -n $err ]] && die "$err"
  own_repo "$dir" || warn "layers/$name isn't a git clone, so deleting it can't be undone"
  undo="tk uninstall --layer=$name"
  [[ $(layer_kit "$dir") != tk ]] && undo="$(layer_kit "$dir") uninstall"   # its parts are fk's (fk uninstall)
  info "${C_DIM}Parts it set up stay set up; to remove them first: $undo${C_RESET}"
  confirm "Remove the $name layer (delete ${dir/#$HOME/\~})?" n || { info "Kept."; return 0; }
  rm -rf "$dir" && pin_set "$ROOT" "$name" && ok "layer $name removed · open a new terminal"
}

cmd_layer() {
  case "${1:-}" in
    "")         cmd_layers ;;
    ls|list)    layer_ls ;;
    add)        shift; layer_add "$@" ;;
    rm|remove)  shift; layer_rm "$@" ;;
    check)      shift; layer_check "$@" ;;
    *)          ui_unknown "uk layer" "$1" ;;
  esac
}

# ---------------------------------------------------------------- doctor ---
# The whole: the commands' names are unikit's, each layer is well formed, no two
# layers (or a layer and unikit) bring the same part or command. tk doctor and
# fk doctor check the parts themselves.
declare -A OKS=() PROBLEMS=()
ORDER=()
check() {  # check <what> <ok|bad> <text> [fix]
  [[ " ${ORDER[*]} " == *" $1 "* ]] || ORDER+=("$1")
  if [[ "$2" == ok ]]; then OKS[$1]=$(( ${OKS[$1]:-0} + 1 ))
  else PROBLEMS[$1]+="$3${4:+  $(ui_hint "$4")}"$'\n'; fi
}

declare -A OWNER=()   # command name -> who brings it (unikit, or the first layer)
unikit_owns() { local f; for f in "$ROOT"/bin/*; do [[ -x $f ]] && OWNER[${f##*/}]=unikit; done; }

# check_layer <dir> [name]: is it well formed; does it clash with what OWNER already has
check_layer() {
  local d=$1 l=${2:-${1##*/}} k t n g w p c f
  check "$l" ok there
  if ! [[ -d $d/bin || -d $d/tk || -d $d/fk || -r $d/shell/init.sh || -r $d/components.sh || -r $d/tools || -r $d/workspaces || -d $d/claude/skills ]]; then
    check "$l" bad "has none of what a layer can hold (bin/, tk/, fk/, shell/init.sh, components.sh, tools, workspaces, claude/skills/)" "lib/layers.sh lists them"
  fi
  if [[ -f $d/kit ]]; then
    k=$(head -1 "$d/kit")
    if [[ -v KIT_LABEL[$k] ]]; then check "$l" ok kit; else check "$l" bad "its kit file says '$k' (tk or fk)"; fi
  fi
  while IFS= read -r t; do   # the layers it needs (its requires file)
    [[ -z $t || $t == \#* ]] && continue
    if [[ -d $ROOT/layers/$t ]]; then check "$l" ok "needs $t"
    else check "$l" bad "needs the $t layer, which isn't here" "uk layers, alt-a adds it"; fi
  done < <(layer_requires "$d")
  if [[ -r $d/components.sh ]]; then
    if t=$(bash -n "$d/components.sh" 2>&1); then check "$l" ok components.sh
    else check "$l" bad "components.sh doesn't parse: $(head -1 <<<"$t")"; fi
  fi
  if [[ -r $d/tools ]]; then
    while IFS= read -r t; do
      [[ -z $t || $t == \#* ]] && continue
      IFS='|' read -r n g w p k <<<"$t"
      if [[ -z $n || -z $g || -z $w ]]; then check "$l" bad "tools line '$t' needs name|group|what it does|program"; continue; fi
      [[ -z $k || -v KIT_LABEL[$k] ]] || check "$l" bad "tools line $n names the kit '$k' (tk or fk)"
      if [[ $n == [tf]k\ * ]]; then   # fk dash2dock is fk/dash2dock
        if [[ -x $d/${n%% *}/${n#* } ]]; then check "$l" ok "$n"; else check "$l" bad "tools lists $n, but there's no ${n%% *}/${n#* }"; fi
      elif [[ -x $d/bin/$n ]] || [[ -v OWNER[$n] ]] || type -P "$n" >/dev/null; then check "$l" ok "$n"
      else check "$l" bad "tools lists $n, but there's no bin/$n"; fi
    done <"$d/tools"
  fi
  for f in "$d"/bin/*; do
    [[ -e $f ]] || continue
    c=${f##*/}
    [[ -x $f ]] || check "$l" bad "bin/$c isn't executable" "chmod +x $f"
    if [[ ${OWNER[$c]:-} == unikit ]]; then check "$l" bad "bin/$c never runs: unikit's $c comes first on PATH"
    elif [[ -v OWNER[$c] ]]; then check "$l" bad "bin/$c: ${OWNER[$c]} has a $c too; the one first on PATH runs"
    else OWNER[$c]=$l; fi
  done
  for f in "$d"/tk/* "$d"/fk/*; do   # the kits' subcommands; a kit's own words (lib/kit.sh) come first
    [[ -e $f ]] || continue
    k=$(basename "$(dirname "$f")") c=${f##*/}
    [[ -x $f ]] || check "$l" bad "$k/$c isn't executable" "chmod +x $f"
    case $c in ls|list|install|uninstall|configs|doctor|help|-h|--help)
      check "$l" bad "$k/$c never runs: $k $c is $k's own" ;; esac

  done
}

# its commit against its pin (layers.lock): nothing new runs that you didn't look at
check_pin() {   # dir name
  local p n
  own_repo "$1" || return 0
  p=$(pin_of "$ROOT" "$2")
  if [[ -z $p ]]; then check "$2" bad "has no pin (added before pins)" "uk update pins it"
  elif [[ $(git -C "$1" rev-parse HEAD) == "$p" ]]; then check "$2" ok pin
  else
    n=$(git -C "$1" rev-list --count "$p..HEAD" 2>/dev/null)
    check "$2" bad "${n:-some} commit(s) since its pin, not looked at in uk update (yours, or pulled by hand)" "uk update shows them"
  fi
}

# the box: a row per check, the problems spelled out; 1 when there's one
report() {   # title subtitle
  local name n p first rows="" bad=0
  for name in "${ORDER[@]}"; do
    if [[ -z "${PROBLEMS[$name]:-}" ]]; then
      n=${OKS[$name]}
      rows+="$C_CYAN$name$C_RESET$S${C_GREEN}✓${C_RESET} $( (( n > 1 )) && echo "all $n checks pass" || echo ok)"$'\n'
      continue
    fi
    first="$C_CYAN$name$C_RESET"
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      rows+="$first$S${C_YELLOW}!${C_RESET} $p"$'\n'; first=""; bad=$((bad + 1))
    done <<<"${PROBLEMS[$name]}"
    n=${OKS[$name]:-0}
    (( n == 1 )) && rows+="$S${C_DIM}1 other check passes${C_RESET}"$'\n'
    (( n > 1 )) && rows+="$S${C_DIM}$n other checks pass${C_RESET}"$'\n'
  done
  local foot; (( bad )) && foot="${C_YELLOW}$bad to fix${C_RESET}" || foot="${C_GREEN}all good${C_RESET}"
  printf '%s' "$rows" | { if [[ -t 1 ]]; then print_table 3 | ui_box "$1" "$2" 0 "$foot"; else print_table 3; fi; }
  (( bad == 0 ))
}

cmd_doctor() {
  [[ -t 1 ]] || ui_no_color
  local name f d t err parts
  # the names: each runs unikit's, not another program of the same name
  for name in uk tk fk unikit toolkit feelkit; do
    f=$(type -P "$name") || {
      [[ $name == [utf]k ]] && check unikit bad "$name isn't on PATH" "tk install commands"; continue; }
    if [[ $(readlink -f "$f") == "$ROOT"/bin/* ]]; then check unikit ok "$name"
    else check unikit bad "$name runs ${f/#$HOME/\~}, not unikit's" "unikit's ${ROOT/#$HOME/\~}/bin must come first on PATH"; fi
  done
  unikit_owns
  parts=$(mktemp)
  err=$(layer_parts 2>&1 >"$parts")
  rm -f "$parts"
  while IFS= read -r d; do check_layer "$d"; check_pin "$d" "${d##*/}"; done < <(layer_dirs "$ROOT")
  # the loader's own words: a part naming an unknown kit, a layer whose part names are taken
  while IFS= read -r t; do
    [[ $t =~ ^✗\ layer\ ([^:]+):\ (.*)$ ]] && check "${BASH_REMATCH[1]}" bad "${BASH_REMATCH[2]}"
  done <<<"$err"
  report "uk doctor" "tk doctor, fk doctor: each part"
}

# uk layer check <dir>: a layer you're making, before you push it: well formed, and nothing
# in it clashes with unikit or the layers here (its own copy in layers/ aside)
layer_check() {
  [[ -t 1 ]] || ui_no_color
  local d=${1:-.} l o f taken
  [[ -d $d ]] || die "there's no folder $d   (uk layer check <the layer's folder>)"
  d=$(cd "$d" && pwd -P); l=${d##*/}
  unikit_owns
  while IFS= read -r o; do   # the others' commands (each layer's own bin/ first wins)
    [[ ${o##*/} == "$l" ]] && continue
    for f in "$o"/bin/*; do [[ -x $f && ! -v OWNER[${f##*/}] ]] && OWNER[${f##*/}]=${o##*/}; done
  done < <(layer_dirs "$ROOT")
  check_layer "$d" "$l"
  if [[ -r $d/components.sh ]]; then   # its part names: none that unikit or another layer has
    taken=$( ( repo=$ROOT mode=dry details=0
      . "$ROOT/lib/setup.sh" >/dev/null 2>&1; . "$ROOT/lib/components.sh" >/dev/null 2>&1
      for id in $(COMPONENTS=(); . "$d/components.sh" >/dev/null 2>&1; printf '%s\n' "${COMPONENTS[@]}"); do
        [[ " ${COMPONENTS[*]} " == *" $id "* && ${LAYER_OF[$id]:-unikit} != "$l" ]] && printf '%s (%s) ' "$id" "${LAYER_OF[$id]:-unikit}"
      done ) )
    if [[ -n $taken ]]; then check "$l" bad "its part names are taken: ${taken% }; the loader would leave all its parts out"
    else check "$l" ok "part names"; fi
  fi
  report "uk layer check" "${d/#$HOME/\~}"
}

# ---------------------------------------------------------------- update ---
# pull_one <dir> <name> <changed file>: pull it, say what changed, add the changed files
# (full paths) to <changed file>
pull_one() {
  local before
  before=$(git -C "$1" rev-parse HEAD)
  git -C "$1" pull --ff-only -q || { warn "$2: git pull failed (output above); left as it was"; return 1; }
  [[ "$(git -C "$1" rev-parse HEAD)" == "$before" ]] && { ok "$2: already up to date"; return 1; }
  ok "$2: updated"
  git -C "$1" log --no-merges --format='  • %s' "$before..HEAD" | head -n 20 >&2
  git -C "$1" diff --name-only "$before" HEAD | sed "s#^#$1/#" >>"$3"
}

# parts_now: "id repo state" for every installer part, fk's too
parts_now() {
  (
    repo=$ROOT mode=dry details=0
    . "$ROOT/lib/setup.sh" >/dev/null 2>&1
    . "$ROOT/lib/components.sh" >/dev/null 2>&1
    for id in "${COMPONENTS[@]}"; do
      component_state "$id" >/dev/null 2>&1
      printf '%s %s %s\n' "$id" "$(repo_of "$id")" "$STATE"
    done
  )
}

# Look for updates to unikit and every layer (fetch: nothing changes yet) and list the ones
# with something new, ticked. A layer whose code changed since its pin (layers.lock: what you
# last trusted) starts unticked: its commits and changed files show under the cursor, alt-i
# the diff; tick it to trust them. Enter pulls the ticked (a layer's pin moves to what it
# pulled), then shows each part against how it was before the pull (install.sh --update,
# lib/update.sh). --yes pulls all but the layers whose code changed; --dry-run and no
# terminal pull nothing.
cmd_update() {
  own_repo "$ROOT" ||
    die "the unikit folder (${ROOT/#$HOME/\~}) isn't a git repo, so there's nothing to update from"
  local d u name n a p to code up how=ask rc=0 rows="" layers=0 i=0 nsel load="select-all"
  local -a dirs=() names=() picked=()
  declare -A gated=()
  for a in "$@"; do case $a in -y|--yes) how=yes ;; -n|--dry-run) how=dry ;; esac; done   # the last one wins, as in install.sh
  u=$(mktemp -d); : >"$u/changed"
  info "${C_DIM}Checking what's set up…${C_RESET}"
  parts_now >"$u/before"
  info "${C_DIM}Looking for updates…${C_RESET}"
  while IFS= read -r d; do
    [[ $d == "$ROOT" ]] && name=unikit || name=${d##*/}
    own_repo "$d" || continue   # a copied folder: nothing to update from
    n=0 to=HEAD up="" p=""
    if git -C "$d" rev-parse -q --verify '@{u}' >/dev/null; then
      if git -C "$d" fetch -q 2>/dev/null; then up=1 n=$(git -C "$d" rev-list --count 'HEAD..@{u}'); (( n )) && to='@{u}'
      else warn "$name: couldn't look for updates (offline?)"; fi
    fi
    if [[ $name != unikit ]]; then
      p=$(pin_of "$ROOT" "$name")
      if [[ -z $p ]] || ! git -C "$d" cat-file -e "$p^{commit}" 2>/dev/null; then   # added before pins: what's there now
        p=$(git -C "$d" rev-parse HEAD)
        [[ $how == dry ]] || { pin_set "$ROOT" "$name" "$p"; ok "$name: pinned at ${p:0:7} (it had no pin)"; }
      fi
    fi
    code=""; [[ -n $p ]] && code=$(layer_code "$d" "$p" "$to")
    if (( ! n )) && [[ -z $code ]]; then
      [[ -n $p && $how != dry ]] && pin_set "$ROOT" "$name" "$(git -C "$d" rev-parse HEAD)"   # only docs since its pin
      [[ -n $up ]] && ok "$name: already up to date"
      continue
    fi
    dirs+=("$d") names+=("$name") i=$((i + 1)); [[ $name == unikit ]] || layers=1
    git -C "$d" log --no-merges --format='• %s' "${p:-HEAD}..$to" | head -n 12 >"$u/log.$name"
    if [[ -n $code ]]; then
      gated[$name]=1 load+="+pos($i)+deselect"
      printf '%s\n' "${C_YELLOW}runs code:${C_RESET} $(paste -sd' ' <<<"$code")" >>"$u/log.$name"
      # shellcheck disable=SC2086
      git -C "$d" diff --color=always "$p" "$to" -- $code >"$u/diff.$name"
    fi
    a=""
    if [[ $name == unikit ]]; then
      local old new; old=$(version) new=$(git -C "$ROOT" show '@{u}:VERSION' 2>/dev/null | tr -d '[:space:]')
      [[ -n $new && $new != "$old" ]] && a="$old → $new"
    fi
    rows+="$name$S$( (( n )) && echo "$n new commit$( (( n == 1 )) || echo s)" || echo "– (since its pin)")"
    rows+="$S$( [[ -n $code ]] && echo "$C_YELLOW! $(wc -l <<<"$code") file(s) changed$C_RESET" || echo –)$S$C_DIM$a$C_RESET"$'\t'"$name"$'\n'
  done < <(printf '%s\n' "$ROOT"; layer_dirs "$ROOT")

  if (( ${#names[@]} )); then
    if [[ $how == yes ]]; then
      for name in "${names[@]}"; do
        if [[ -v gated[$name] ]]; then warn "$name: held back, its code changed since you last trusted it: uk update in a terminal shows it"
        else picked+=("$name"); fi
      done
    elif [[ $how == ask && -t 0 && -t 1 ]] && type -P fzf >/dev/null; then
      local note="" foot=()
      [[ " ${names[*]} " == *" unikit "* ]] && (( layers )) &&
        note="# layers may need the newer unikit: keep it ticked when you pull a layer"$'\n'
      (( ${#gated[@]} )) && note+="# ! a layer whose code changed starts unticked: read it (alt-i), tick it to trust it"$'\n'
      ui_fzf_at_least 0.63 && foot=(--footer=' ' --bind="focus:transform-footer(cat $u/log.{2})")
      nsel="$u/nsel"
      a=$(printf '%s%s' "REPO${S}NEW${S}CODE${S}VERSION"$'\t\n' "$rows" |
        ui_fzf 'uk update · pull which?' --multi --header-lines=1 --delimiter=$'\t' --with-nth=1 \
          --header="${note}tab: tick/untick · ctrl-a: all/none · alt-i: the code's diff · enter: pull the ticked · esc: pull nothing" \
          --bind="load:$load+first,ctrl-a:toggle-all,alt-i:toggle-preview" "${foot[@]}" \
          --preview="cat $u/diff.{2} 2>/dev/null || echo 'No code changed: only docs and lists.'" --preview-window='right,60%,hidden' \
          --bind="enter:execute-silent(echo \$FZF_SELECT_COUNT >$nsel)+accept" | cut -f2) ||
        { rm -rf "$u"; info "Cancelled. Nothing pulled."; return 0; }
      mapfile -t picked <<<"$a"
      [[ $(cat "$nsel" 2>/dev/null) == 0 ]] && picked=()   # nothing ticked: fzf hands back the cursor's row
    else   # no terminal to pick in, or --dry-run: say what's there, pull nothing
      printf '%s' "$rows" | cut -f1 | { printf '%s\n' "REPO${S}NEW${S}CODE${S}VERSION"; cat; } |
        ui_table "uk update" "${#names[@]} with updates" >&2
      for name in "${names[@]}"; do sed "s/^/  $name: /" "$u/log.$name" >&2; done
      info "Nothing pulled: ${C_BOLD}uk update${C_RESET} in a terminal picks what to pull; --yes pulls all but changed layer code"
    fi
    for i in "${!dirs[@]}"; do
      d=${dirs[$i]} name=${names[$i]}
      if [[ " ${picked[*]} " == *" $name "* ]]; then
        if [[ $name == unikit ]]; then
          a=$(version)
          pull_one "$d" unikit "$u/changed"
          [[ $(version) != "$a" ]] && ok "unikit $a → ${C_BOLD}$(version)${C_RESET}"
        else
          git -C "$d" rev-parse -q --verify '@{u}' >/dev/null && [[ -n $(git -C "$d" rev-list 'HEAD..@{u}') ]] &&
            pull_one "$d" "layer $name" "$u/changed"
          pin_set "$ROOT" "$name" "$(git -C "$d" rev-parse HEAD)"
          [[ -v gated[$name] ]] && ok "$name: trusted, pinned at $(git -C "$d" rev-parse --short HEAD)"
        fi
      elif [[ $how == ask && -t 0 && -t 1 ]]; then info "${C_DIM}$name: not pulled (uk update again any time)${C_RESET}"; fi
    done
  fi
  "$ROOT/install.sh" --update="$u" "$@" || rc=$?
  rm -rf "$u"
  return "$rc"
}

# ---------------------------------------------------------------- status ---
# Each kit's parts: "kit set-up total left-ids" per kit with parts that apply here
kits_state() {
  ( repo=$ROOT mode=dry details=0
    # shellcheck source=../lib/setup.sh
    . "$ROOT/lib/setup.sh" >/dev/null 2>&1
    # shellcheck source=../lib/components.sh
    . "$ROOT/lib/components.sh" >/dev/null 2>&1
    local k id n total left
    for k in tk fk; do
      n=0 total=0 left=""
      for id in $(kit_parts "$k"); do
        "$(fn state "$id")" >/dev/null 2>&1
        [[ $STATE == n/a || $STATE == unsupported ]] && continue
        total=$((total + 1))
        if [[ $STATE == installed ]]; then n=$((n + 1)); else left+="$id "; fi
      done
      (( total )) && printf '%s %s %s %s\n' "$k" "$n" "$total" "$left"
    done )
}
cmd_status() {
  [[ -t 1 ]] || ui_no_color
  local k n total left rows="" names="" d r
  rows+="folder"$'\t'"${ROOT/#$HOME/\~}"$'\n'
  while IFS= read -r d; do names+="${d##*/}, "; done < <(layer_dirs "$ROOT")
  rows+="layers"$'\t'"${names:+${names%, }  }$(ui_hint 'uk layers')"$'\n'
  while read -r k n total left; do
    [[ -n $k ]] || continue
    if [[ -z $left ]]; then rows+="$k"$'\t'"${C_GREEN}all $total parts set up${C_RESET}"$'\n'
    else rows+="$k"$'\t'"${C_YELLOW}$n of $total parts set up${C_RESET}  $(ui_hint "$k install ${left% }")"$'\n'; fi
  done < <(kits_state)
  if r=$(rev_of "$ROOT") && [[ -n $r ]]; then rows+="version"$'\t'"$(version) ${C_DIM}($r)${C_RESET}  $(ui_hint 'uk update')"
  else rows+="version"$'\t'"$(version) ${C_DIM}(not a git repo, so no updates)${C_RESET}"; fi
  printf '%s\n' "$rows" | ui_fields "uk · unikit"
}

# --------------------------------------------------------------- version ---
cmd_version() {
  local r d; r=$(rev_of "$ROOT")
  printf 'unikit %s%s\n' "$(version)" "${r:+  $C_DIM($r)$C_RESET}"
  while IFS= read -r d; do printf '  %-12s %s\n' "${d##*/}" "$C_DIM$(layer_ver "$d")$C_RESET"; done < <(layer_dirs "$ROOT")
}

# ----------------------------------------------------------- the picker ---
cmd_pick() {
  if [[ ! -t 0 || ! -t 1 ]] || ! type -P fzf >/dev/null; then cmd_help; return; fi
  local sel rows="COMMAND${S}WHAT IT DOES"$'\n'
  rows+="uk status${S}what's set up in each kit, the layers, the version"$'\n'
  rows+="uk layers${S}the layers: add, remove, set up, about"$'\n'
  rows+="uk doctor${S}is each layer well formed; no clashes"$'\n'
  rows+="uk update${S}pull what's new in unikit and each layer"$'\n'
  rows+="uk version${S}unikit's version and each layer's"$'\n'
  rows+="tk${S}toolkit: the commands you work with"$'\n'
  rows+="fk${S}feelkit: how things look"$'\n'
  sel=$(printf '%s' "$rows" | ui_fzf 'uk · unikit' --header-lines=1 --prompt='command> ' \
    --header='enter: run it · esc: cancel') || return 0
  sel=$(strip_ansi "$sel"); sel=${sel%%   *}
  [[ -n $sel ]] || return 0
  # shellcheck disable=SC2086
  set -- $sel
  case $1 in uk) shift; exec "$SELF" "$@" ;; *) exec "$ROOT/bin/$1" ;; esac
}

cmd_help() {
  ui_help uk "unikit: the base; tk and fk are its kits" <<'EOF'
## Commands
uk	pick one of these and run it
uk status	the folder, the layers, how much of each kit is set up, the version	also uk st
uk layers	the layers in a list: add one, set up or remove its parts, remove it; alt-i shows what each one is	not in a terminal: a table
uk layer add <git-url> [name]	clone a layer, show what of it runs and ask before keeping it (pinned in layers.lock), then offer to set up its parts	name: repo name without unix- and -toolkit · --yes: no asking
uk layer rm <name>	delete a layer (only when nothing in it is unpushed)
uk layer check <dir>	a layer you're making, before you push it: well formed, no clashes with unikit or the layers here
uk update	what's new in unikit and each layer; pulls the ones you tick (a layer whose code changed since you trusted it starts unticked: alt-i shows the diff), then each part: up to date, needs a fix, new or removed	--yes pulls all but changed layer code; no terminal: pulls nothing
uk doctor	the whole: the commands are unikit's, each layer is well formed, no two bring the same part or command	each kit's commands and parts: tk doctor, fk doctor
uk version	unikit's version and each layer's (also -v, --version)
uk help	this page

## The kits
tk	toolkit: what you work with (tk help)
fk	feelkit: how things look (fk help)
EOF
}

case "${1:-}" in
  "")             cmd_pick ;;
  layers)         shift; if [[ -z ${1:-} ]]; then cmd_layers; else cmd_layer "$@"; fi ;;
  layer)          shift; cmd_layer "$@" ;;
  doctor)         cmd_doctor ;;
  st|status)      cmd_status ;;
  update)         shift; cmd_update "$@" ;;
  version|-v|--version) cmd_version ;;
  help|-h|--help) cmd_help ;;
  __key)     [[ -z ${NO_COLOR:-} ]] && ui_color; lay_key "${2:-}" "${3:-}" "${4:-}" ;;
  __relist)  [[ -z ${NO_COLOR:-} ]] && ui_color; lay_relist ;;
  __about)   [[ -z ${NO_COLOR:-} ]] && ui_color; lay_about "${2:-}" ;;
  *)              ui_unknown uk "$1" ;;
esac
